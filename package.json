{
  "name": "Jusclick",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "vite --port=3000 --host=0.0.0.0",
    "setup": "node setup.mjs",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:android": "tsc -b && vite build && npx cap sync android",
    "build:ios": "tsc -b && vite build && npx cap sync ios",
    "build:windows": "tsc -b && vite build && npx electron-builder --win",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.46.0",
    "lucide-react": "^0.542.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "sharp": "^0.34.3",
    "typescript": "^7.0.2",
    "vite": "^7.0.2"
  }
}
