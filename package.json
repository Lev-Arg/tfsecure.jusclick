{
  "name": "tfsecure",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "vite --port=3000 --host=0.0.0.0",
    "setup": "node setup.mjs",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:android": "tsc -b && vite build && npx cap sync android",
    "build:ios": "tsc -b && vite build && npx cap sync ios",
    "build:windows": "tsc -b && vite build && npx electron-builder --win",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.17.0",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.5.0",
    "vite": "^8.3.2"
  }
}
